{
  "name": "ndthich-land",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c playwright.mock.config.ts",
    "test:e2e:mock": "playwright test -c playwright.mock.config.ts",
    "test:e2e:failclosed": "next build && playwright test -c playwright.failclosed.config.ts",
    "test:e2e:live": "node scripts/check-live-e2e-secrets.mjs && next build && playwright test -c playwright.live.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run test:e2e:mock && npm run test:e2e:failclosed",
    "gd6:hash-password": "node scripts/hash-password.mjs",
    "gd6:bootstrap-cms": "tsx scripts/gd6-bootstrap-cms.ts",
    "assets:round8": "node scripts/optimize-round8-assets.mjs"
  },
  "dependencies": {
    "googleapis": "^174.0.1",
    "next": "16.3.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.2.108",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "24.13.3",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "24.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "8.5.26",
    "prettier": "3.3.3",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.7",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0"
  }
}
