# Public deployment identity
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_ZALO_URL=https://zalo.me/your-account
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Google service account and data sources
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
GOOGLE_RENTAL_SPREADSHEET_ID=replace-me
GOOGLE_CMS_SPREADSHEET_ID=replace-me
GOOGLE_MEDIA_FOLDER_ID=replace-me

# Admin authentication (generate the hash with `npm run gd6:hash-password`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-me
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Recommended dedicated HMAC secrets; AUTH_SECRET is the safe fallback
RATE_LIMIT_SECRET=replace-with-an-independent-random-secret
DRIVE_MEDIA_PROXY_SECRET=replace-with-an-independent-random-secret

# Optional internal admin-only Claude endpoint
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local/client-preview flags only. Never enable these in real production.
DEMO_MODE=false
VISUAL_FIXTURE_V2=false
AUTH_COOKIE_INSECURE=false
