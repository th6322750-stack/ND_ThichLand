# Biến môi trường cho VPS — MẪU, không chứa giá trị thật.
#
# Bản có giá trị thật được bàn giao riêng qua kênh bảo mật, KHÔNG nằm trong
# git. Xem mục "Bàn giao gồm những gì" ở đầu DEPLOY_VPS.md.
#
# Đặt tại /opt/ndthichland/.env rồi: chmod 600 /opt/ndthichland/.env
# systemd nạp file này qua EnvironmentFile (xem mục 4b).

# --- Chạy ---
NODE_ENV=production
PORT=3000
# 127.0.0.1: Node chỉ nghe nội bộ, ra ngoài qua nginx
HOSTNAME=127.0.0.1
NEXT_PUBLIC_SITE_URL=https://ndthichland.com.vn

# --- Ảnh tải lên ---
# BẮT BUỘC nằm ngoài thư mục deploy, nếu không mất sạch mỗi lần deploy lại.
MEDIA_STORAGE_DIR=/var/lib/ndthichland/media

# --- Google (dữ liệu nội dung nằm trong Google Sheets) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=<email-service-account>

# QUAN TRỌNG: viết trên ĐÚNG MỘT DÒNG, xuống dòng thay bằng ký tự \n.
# systemd không đọc được giá trị nhiều dòng — dán nguyên khoá nhiều dòng vào
# đây là service không khởi động nổi. Code tự chuyển \n thành xuống dòng thật.
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<...>\n-----END PRIVATE KEY-----\n

GOOGLE_CMS_SPREADSHEET_ID=<id-google-sheet>
# Đặt CÙNG giá trị với dòng trên
GOOGLE_RENTAL_SPREADSHEET_ID=<id-google-sheet>

# KHÔNG set GOOGLE_MEDIA_FOLDER_ID trên VPS — có nó là app quay lại dùng
# Google Drive và tải ảnh sẽ hỏng (xem mục 4).
# KHÔNG set DEMO_MODE — không còn tác dụng khi đã có Google.

# --- Đăng nhập trang quản trị ---
ADMIN_EMAIL=<email-dang-nhap-admin>
# Hash scrypt, không phải mật khẩu thường. Sinh mới: npm run gd6:hash-password
ADMIN_PASSWORD_HASH=<hash-scrypt>
# Khoá ký phiên đăng nhập. TỐI THIỂU 32 ký tự — ngắn hơn là toàn bộ chức năng
# đăng nhập bị vô hiệu ở production (code cố tình fail-closed).
# Sinh mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=<chuoi-ngau-nhien-toi-thieu-32-ky-tu>
